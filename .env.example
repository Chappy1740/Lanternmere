# ============================================================
# Lanternmere Environment Variables
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real credentials.
# ============================================================

# --- Supabase (client-exposed — safe to expose in browser) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# --- Supabase (server-only — NEVER expose to the client) ---
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxx
# Only this Lanternmere auth account can see the anonymized app-wide signup directory.
# Find your own account reference on /membership after signing in.
# APP_OWNER_PROFILE_ID=00000000-0000-4000-8000-000000000000

# --- Blizzard Battle.net OAuth (server-only) ---
# Required to enable live Guild Master claims; omit to keep that flow locked.
# Create/manage credentials at https://develop.battle.net/access/clients
# BLIZZARD_CLIENT_ID=your-client-id
# BLIZZARD_CLIENT_SECRET=your-client-secret
# Must exactly match a Redirect URI registered on the Battle.net client
# BLIZZARD_REDIRECT_URI=http://localhost:3000/api/guild-claim/callback
# Region determines the API host (us, eu, kr, tw)
BLIZZARD_REGION=us

# --- Warcraft Logs public API (server-only) ---
# Create an OAuth client at https://www.warcraftlogs.com/api/clients
# Both values are needed to read public reports; private reports are not supported.
# WARCRAFT_LOGS_CLIENT_ID=your-client-id
# WARCRAFT_LOGS_CLIENT_SECRET=your-client-secret

# --- Optional Lanternkeeper AI summary (server-only) ---
# The factual briefing works without these. Configure only after the Milestone 14
# request-budget migration is installed and Guild data-sharing policy is approved.
# OPENAI_API_KEY=your-private-api-key
# OPENAI_MODEL=gpt-6-luna

# --- Runtime ---
NODE_ENV=development
